#!/usr/bin/env bash
set -ex

cd $(dirname $0)/..

source ./scripts/version.sh

# Minimum buildx version that contains https://github.com/docker/buildx/pull/4008
BUILDX_VERSION=$(docker buildx version | awk '{print $2}')
MIN_BUILDX_VERSION=$(printf '%s\n' "${BUILDX_VERSION}" "v0.37.0" | sort -V | sed -n '1p')
if [ "${MIN_BUILDX_VERSION}" != "v0.37.0" ]; then
    echo "Buildx version must be >= v0.37.0"
    exit 1
fi

docker buildx build ${IID_FILE_FLAG} \
    --sbom=true \
    --attest type=provenance,mode=max \
    --build-arg TAG=${VERSION} \
    --build-arg KUBERNETES_VERSION=${KUBERNETES_VERSION} \
    --build-arg MAJOR=${VERSION_MAJOR} \
    --build-arg MINOR=${VERSION_MINOR} \
    --build-arg CACHEBUST="$(date +%s%N)" \
    --tag ${REPO}/${PROG}-runtime:${DOCKERIZED_VERSION}-windows-amd64 \
    --target windows-runtime \
    --file Dockerfile.windows \
    --platform 'windows(10.0.17763.7919)/amd64,windows(10.0.20348.4294)/amd64,windows(10.0.26100.4294)/amd64' \
    --push \
    .
