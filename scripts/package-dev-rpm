#!/usr/bin/env bash
set -ex

cd $(dirname $0)/..

source ./scripts/version.sh

export COMMIT
export COMBARCH='x86_64-amd64'

RPM_VERSION="${VERSION}.testing.0"

TMPDIR=$(mktemp -d -t)
cleanup() {
    exit_code=$?
    trap - EXIT INT
    rm -rf "${TMPDIR}"
    git tag -d "${RPM_VERSION}" || true
    exit ${exit_code}
}
trap cleanup EXIT INT

git clone https://github.com/rancher/rke2-packaging.git "${TMPDIR}"

export RPM_TOPDIR="${TMPDIR}/rpmbuild"
SRC_PATH="${RPM_TOPDIR}/SOURCES/x86_64"
DIST_PATH=$(realpath -mq ./dist/rpms)

[ -d "${DIST_PATH}" ] || mkdir "${DIST_PATH}"
[ -d "${SRC_PATH}" ] || mkdir -p "${SRC_PATH}"
cp ./dist/artifacts/* "${SRC_PATH}"

# Mock spectool, not needed for local builds
mkdir "${TMPDIR}/bin"
echo 'exit 0' > "${TMPDIR}/bin/spectool"
chmod +x "${TMPDIR}/bin/spectool"
cp "${TMPDIR}/bin/spectool" "${TMPDIR}/bin/rpmdev-spectool"
# Do not check for build dependencies, systemd-rpm-macros should suffice
echo "exec $(command -v rpmbuild) --nodeps \"\$@\"" > "${TMPDIR}/bin/rpmbuild"
chmod +x "${TMPDIR}/bin/rpmbuild"
export PATH="${TMPDIR}/bin:${PATH}"

# Set rpmmacros that differ in Alpine from RHEL distributions
echo "%_topdir ${HOME}/rpmbuild" > ~/.rpmmacros
echo "%_sharedstatedir /var/lib" >> ~/.rpmmacros
echo "%_localstatedir /var" >> ~/.rpmmacros

# Set rpm version as lightweight tag
git tag "${RPM_VERSION}"

for RPM_OS in centos8 centos9 centos10 microos slemicro sle; do
    rm -rf "${RPM_TOPDIR}/RPMS" "${RPM_TOPDIR}/SRPMS"
    TAG=${RPM_VERSION} RPM_OS=${RPM_OS} bash "${TMPDIR}/rpm/scripts/build.sh"
done

cp -r "${TMPDIR}"/dist/* "${DIST_PATH}"
